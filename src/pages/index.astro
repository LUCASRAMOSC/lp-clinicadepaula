---
import BaseLayout from '../layouts/BaseLayout.astro'
import { site } from '../config/site'
import SmartNavigation from '../components/navigation/SmartNavigation'
import HeroMotion from '../components/interactive/HeroMotion'
import Experience from '../sections/Experience.astro'
import '../styles/page.css'
---

<BaseLayout title={site.title} description={site.description}>
  <header class="smart-header">
    <SmartNavigation client:load brandName={site.name} items={site.navigation} />
  </header>

  <main>
    <HeroMotion client:load />

    <section id="tratamentos" class="section-anchor page-section page-section--surface">
      <div class="page-container">
        <p class="section-eyebrow">Tratamentos</p>
        <h2 class="section-title section-title--wide">Cada cuidado merece atenção especial.</h2>
        <p class="section-description">Em breve, apresentaremos os procedimentos e seus detalhes, definidos com as profissionais da clínica.</p>
      </div>
    </section>

    <section id="equipe" class="section-anchor page-section">
      <div class="page-container">
        <p class="section-eyebrow">Conheça nossa equipe</p>
        <h2 class="section-title">Cuidado feito por pessoas.</h2>
        <div class="team-grid">
          {site.professionals.map((professional) => (
            <article class="team-card">
              <div class="team-card__accent" aria-hidden="true"></div>
              <h3 class="team-card__name">{professional.name}</h3>
              <p class="team-card__description">Apresentação e fotografia em preparação.</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <Experience />

    <section id="contato" class="section-anchor page-section page-section--contact">
      <div class="page-container">
        <p class="section-eyebrow section-eyebrow--light">Contato</p>
        <h2 class="section-title section-title--wide">Seu cuidado começa com uma conversa.</h2>
        <p class="section-description">Os canais oficiais de agendamento serão adicionados após a validação da clínica.</p>
      </div>
    </section>
  </main>

  <footer class="page-footer"><p>Clínica de Paula · Prévia de desenvolvimento</p></footer>
</BaseLayout>
