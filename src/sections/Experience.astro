---
import { ArrowUpRight } from 'lucide-react'
import '../styles/experience.css'
---
<section id="experiencia" class="section-anchor page-section experience-section" aria-labelledby="experience-title">
  <div class="page-container experience-section__grid">
    <div class="experience-section__copy">
      <p class="section-eyebrow">A experiência</p>
      <h2 id="experience-title" class="section-title">Um espaço para cuidar de você.</h2>
      <p class="section-description">
        Estamos preparando um olhar mais próximo para a Clínica de Paula,
        com fotografias reais dos ambientes e dos detalhes que fazem parte deste espaço.
      </p>
      <a href="#contato" class="experience-section__link">
        Entre em contato
        <ArrowUpRight size={18} strokeWidth={1.7} aria-hidden="true" />
      </a>
    </div>
    <div class="experience-section__visual" role="img" aria-label="Área reservada para fotografia oficial da clínica">
      <span class="experience-section__visual-kicker">CLÍNICA DE PAULA</span>
      <span class="experience-section__visual-caption">Fotografia institucional em breve</span>
      <span class="experience-section__visual-edge" aria-hidden="true"></span>
    </div>
  </div>
</section>
